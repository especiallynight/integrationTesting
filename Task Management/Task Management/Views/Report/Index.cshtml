@model Task_Management.Models.ReportDto

@{
    ViewData["Title"] = "Reports & Analytics";
}

<style>
    .report-filter-card {
        background-color: #f8f9fa;
        border: 2px solid #9370DB;
        border-radius: 8px;
        padding: 20px;
        margin-top: 30px;
        margin-bottom: 30px;
    }

    .report-summary-cards {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        flex: 1;
        padding: 20px;
        border-radius: 8px;
        color: white;
        text-align: center;
        font-weight: bold;
    }

    .stat-total { background-color: #6c757d; }
    .stat-completed { background-color: #28a745; }
    .stat-in-progress { background-color: #007bff; }
    .stat-canceled { background-color: #dc3545; }

    .btn-export-excel {
        background-color: #1D6F42;
        color: white;
        font-size: 18px;
        padding: 10px 20px;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
    }


    .btn-export-excel:hover{
        color: white;
        opacity: 0.9;
    }
</style>

<div class="container" style="margin-top: 30px;">
    <h2>📊 Reports & Analytics</h2>

    <div class="report-filter-card">
        <form method="get" asp-controller="Report" asp-action="Index" class="row align-items-end">
            <div class="col-md-4">
                <label for="startDate" class="form-label"><b>Start Date:</b></label>
                <input type="date" id="startDate" name="startDate" class="form-control form-control-lg" 
                       value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-4">
                <label for="endDate" class="form-label"><b>End Date:</b></label>
                <input type="date" id="endDate" name="endDate" class="form-control form-control-lg" 
                       value="@Model.EndDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-4">
                <button type="submit" class="submit-button" style="margin: 0; width: 100%;">Generate Report</button>
            </div>
        </form>
    </div>

    <div class="report-summary-cards">
        <div class="stat-card stat-total">
            <h3>Total Tasks</h3>
            <h2>@Model.TotalTasks</h2>
        </div>
        <div class="stat-card stat-completed">
            <h3>Completed</h3>
            <h2>@Model.CompletedTasksCount</h2>
        </div>
        <div class="stat-card stat-in-progress">
            <h3>In Progress</h3>
            <h2>@Model.InProgressTasksCount</h2>
        </div>
        <div class="stat-card stat-canceled">
            <h3>Canceled / Abandoned</h3>
            <h2>@Model.CanceledTasksCount</h2>
        </div>
    </div>

    <div class="d-flex gap-3 mb-4">
        <a asp-controller="Report" asp-action="DownloadExcel" 
           asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" 
           asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")" 
           class="btn-export-excel">
            📥 Export to Excel (.xlsx)
        </a>
    </div>

    <h3>Detailed Tasks List</h3>
    <table id="tasks-table" border="1" cellpadding="8" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-bottom: 50px;">
        <thead>
            <tr>
                <th>ID</th>
                <th>Task Name</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Date Added</th>
                <th>Deadline Date</th>
                <th>Allocated Days</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Tasks.Any())
            {
                @foreach (var task in Model.Tasks)
                {
                    <tr>
                        <td>@task.TaskId</td>
                        <td>@task.TaskName</td>
                        <td>@task.StatusName</td>
                        <td>@task.PriorityName</td>
                        <td>@task.DateAdded.ToString("yyyy-MM-dd")</td>
                        <td>@task.DeadlineDate.ToString("yyyy-MM-dd")</td>
                        <td>@task.DaysAllocated days</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align: center; color: gray;">No tasks found for the selected period.</td>
                </tr>
            }
        </tbody>
    </table>
</div>